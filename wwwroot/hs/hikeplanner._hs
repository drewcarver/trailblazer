def getPointSelect(day)
    return #{"camp-point-select-day-" + day}
end

def isValidNumber(numericValue)
    return numericValue is a Number and not Number.isNaN(numericValue)
end

def areAllPointsSelected()
    for select in <select[name="campPoints"]/>
        if not select's selectedOptions[0].value then
            return false
        end
    end
    return true
end

def filterByMileRange(selectElement, minMile, maxMile)
    for option in selectElement's options
        set optionMile to option's dataset.mile as Float
        remove @disabled from option

        if isValidNumber(optionMile) and isValidNumber(minMile) and isValidNumber(maxMile) then
            if optionMile < minMile or optionMile > maxMile or option's @disabled is not empty then
                add @disabled to option
            end
        end
    end
end

def getStartAndEndMilesFromSelect(selectElement)
    set dayOfSelect to selectElement's @data-day as Int
    set selectedOption to selectElement's selectedOptions

    if dayOfSelect is 1 then
        set nextDay to dayOfSelect + 1
        set startMile to selectedOption.dataset.mile as Float
        set endMile to getPointSelect(nextDay).selectedOptions.dataset.mile as Float
    else
        set nextDay to dayOfSelect - 1
        set startMile to getPointSelect(nextDay).selectedOptions.dataset.mile as Float
        set endMile to selectedOption.dataset.mile as Float
    end

    return {startMile: startMile, endMile: endMile, dayOfSelect: dayOfSelect, nextDay: nextDay}
end

def refreshMileBoundaries(currentDay)
    for select in <select[name="campPoints"]/>
        set dayOfSelect to select's @data-day as Int
        set startMile to 0
        set endMile to Infinity

        if dayOfSelect is not 1
            set previousDaySelect to getPointSelect(dayOfSelect - 1)
            set startMile to previousDaySelect's selectedOptions.dataset.mile as Float
        end

        if dayOfSelect is not currentDay
            set nextDaySelect to getPointSelect(dayOfSelect + 1)
            set endMile to nextDaySelect's selectedOptions.dataset.mile as Float
        end

        call filterByMileRange(select, startMile, endMile)
    end
end

behavior AddPoint()
    on click
        set currentSelect to the closest <div/> to getPointSelect(^campCounter)

        set clone to currentSelect.cloneNode(true)
        increment ^campCounter

        set @id of <select/> in clone to "camp-point-select-day-" + ^campCounter
        set @data-day of <select/> in clone to ^campCounter
        set @for of <label/> in clone to "camp-point-select-day-" + ^campCounter
        set innerHTML of <label/> in clone to "Day " + ^campCounter

        put clone after currentSelect 
        call refreshMileBoundaries(^campCounter)

        send pointAdded(day: ^campCounter) to the <button /> where its textContent is "Remove Point" 
    end
    on pointSelected
        if areAllPointsSelected() then
            remove @disabled from me
        else
            add @disabled to me
        end
    end
end

behavior SelectPoint()
    on change
        set result to getStartAndEndMilesFromSelect(target)
        if isValidNumber(result.startMile) and isValidNumber(result.endMile) then
            call drawPath(result.startMile, result.endMile, result.dayOfSelect)
        end
        call refreshMileBoundaries(^campCounter)

        send pointSelected to the <button /> where its textContent is "Add Point"
    end
end

behavior RemovePoint()
    on click
        set currentSelect to getPointSelect(^campCounter)
        set containerDiv to the closest <div/> to currentSelect
        set removedDay to currentSelect's @data-day as Int
        call removeHikeLayer(removedDay)
        decrement ^campCounter

        remove containerDiv

        if (^campCounter is 2) then
            add @disabled to me
        end

        call refreshMileBoundaries(^campCounter)
    end
    on pointAdded(day)
        remove @disabled from me
    end
end

def drawPaths()
    refreshMileBoundaries(^campCounter)

    for select in <select[name="campPoints"]/>
        set result to getStartAndEndMilesFromSelect(select)
        if isValidNumber(result.startMile) and isValidNumber(result.endMile) then
            call drawPath(result.startMile, result.endMile, result.dayOfSelect)
        end
    end
end

behavior InitForm()
    on load
        if ^campCounter is undefined 
            set matchingSelects to <select[data-day] /> 
            set days to []
            for select in matchingSelects 
                add select's @data-day as Int to days 
            end
            call Math.max.apply(null, days)
            set ^campCounter to the result 

            wait for 500ms
            call drawPaths()
        end
    end
end
